<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - HalfChessServer</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/HalfChessServer.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-sm navbar-toggleable-sm navbar-light bg-dark border-bottom box-shadow mb-3">
            <div class="container">
                <a class="navbar-brand text-warning" asp-area="" asp-page="/Index">HalfChess</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link  @if(ViewData["nav"] =="Home Page"){
                                        @("text-success")
                                }
                                else{
                                    @("text-white")
                                }" asp-area="" asp-page="/Index">About</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link  @if(ViewData["nav"] =="Players"){
                                        @("text-success")
                                }
                                else{
                                    @("text-white")
                                }" asp-area="" asp-page="/Players/Index">Players</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link  @if(ViewData["nav"] =="Histories"){
                                        @("text-success")
                                }
                                else{
                                    @("text-white")
                                }" asp-area="" asp-page="/Histories/Index">Games</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link
                                @if(ViewData["nav"] =="Register"){
                                        @("text-success")
                                }
                                else{
                                    @("text-white")
                                }" asp-area="" asp-page="/Players/Create">Register</a>
                        </li>
                        @*  <li class="nav-item">
                             <a class="nav-link @if(ViewData["nav"] =="About"){
                                     @("text-success")
                                 }
                                 else{
                                     @("text-white")
                                 }" asp-area="" asp-page="/Players/Edit">About</a>
                         </li> *@
                        <li class="nav-item">
                            <a class="nav-link @if(ViewData["nav"] == "Addition"){
                                    @("text-success")
                                }
                                else{
                                    @("text-white")
                                }" asp-area="" asp-page="/Queries/AllPlayers">Addition Queries</a>
                        </li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container mt-5">
        @if (ViewData["nav"] == "Addition")
        {
            <div class="row">
                <div class="col-3 border-end">
                    <nav class="navbar bg-light">
                        <ul class="navbar-nav">
                            <li class="nav-item">
                                <a class="nav-link @if(ViewData["query"] =="all players"){
                                    @("text-danger")
                                }
                                else{
                                    @("text-success")
                                }" asp-area="" asp-page="/Queries/AllPlayers">All Players</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @if(ViewData["query"] =="Last game of Players"){
                                        @("text-danger")
                                }
                                else{
                                    @("text-success")
                                }" asp-area="" asp-page="/Queries/LastGame">Last game of Players</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @if(ViewData["query"] =="all games"){
                                        @("text-danger")
                                }
                                else{
                                    @("text-success")
                                }" asp-area="" asp-page="/Queries/AllGames">All games</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @if(ViewData["query"] =="all Players by quantity of game"){
                                        @("text-danger")
                                }
                                else{
                                    @("text-success")
                                }" asp-area="" asp-page="/Queries/ByQuantityOfGames">All Players by quantity of game</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @if(ViewData["query"] =="coutries"){
                                        @("text-danger")
                                }
                                else{
                                    @("text-success")
                                }" asp-area="" asp-page="/Queries/Countries">First player ever played in countries</a>
                                
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @if(ViewData["query"] == "games of player"){
                                        @("text-danger")
                                }
                                else{
                                    @("text-success")
                                }" asp-area="" asp-page="/Queries/GamesOfPlayer">Games of player</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link @if(ViewData["query"] == "players of country"){
                                        @("text-danger")
                                }
                                else{
                                    @("text-success")
                                }" asp-area="" asp-page="/Queries/PlayersOfCountry">Aggregate players by countries</a>
                            </li>
                        </ul>
                    </nav>
                </div>
                <div class="col-9">
                    <main role="main" class="pb-3">
                        @RenderBody()
                    </main>
                </div>
            </div>
        }
        else
        {
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        }

    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
      By Tomer Kraft
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>