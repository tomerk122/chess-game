@page
@model HalfChessServer.Pages.Queries.PlayersOfCountryModel

@{
    ViewData["nav"] = "Addition";
    ViewData["query"] = "players of country";
    ViewData["Title"] = "Queries";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<form asp-action="GamesOfPlayer" method="get" class="row">
    <div class="col-5">
        <h2>Players By Country :</h2>
    </div>
    <div class="col-5">
        <div class="input-group">
            <select asp-for="SelectedCountryId" name="selectedCountryId" class="form-control" asp-items="ViewBag.Countries">
                <option value="">All</option>
            </select>
            <div class="input-group-btn">
                <button type="submit" class="btn btn btn-outline-primary"> View</button>
            </div>
        </div>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Players[0].PlayerNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Players[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Players[0].PhoneNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Players[0].RegistedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Players[0].Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Players[0].Country)
            </th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Players)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.PlayerNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.PhoneNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.RegistedDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Quantity)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Country.Name)
                </td>
                
            </tr>
        }
    </tbody>
</table>
