@page
@model HalfChessServer.Pages.Histories.EditModel

@{
    ViewData["Title"] = "Edit";
    ViewData["nav"] = "Histories";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Edit</h1>

<h4>Games</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="History.Id" />
            <div class="form-group">
                <label asp-for="History.AtFrom" class="control-label"></label>
                <input asp-for="History.AtFrom" class="form-control" />
                <span asp-validation-for="History.AtFrom" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="History.AtTo" class="control-label"></label>
                <input asp-for="History.AtTo" class="form-control" />
                <span asp-validation-for="History.AtTo" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="History.Result" class="control-label"></label>
                <input asp-for="History.Result" class="form-control" />
                <span asp-validation-for="History.Result" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="History.PlayerId" class="control-label"></label>
                <select asp-for="History.PlayerId" class="form-control" asp-items="ViewBag.PlayerId"></select>
                <span asp-validation-for="History.PlayerId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
