@page
@model HalfChessServer.Pages.Histories.IndexModel

@{
    ViewData["Title"] = "Index";
    ViewData["nav"] = "Histories";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>All Games</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                Game ID
            </th>
            <th>
                @Html.DisplayNameFor(model => model.History[0].AtFrom)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.History[0].AtTo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.History[0].Result)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.History[0].Player)
            </th>
            <th>
                Player ID
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.History) {
        <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Id)
                </td>
            <td>
                @Html.DisplayFor(modelItem => item.AtFrom)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AtTo)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Result)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Player.Name)
            </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Player.Id)
                </td>
            <td>
             @*    <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> | I Dont want that user will be able to change games *@
                <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
