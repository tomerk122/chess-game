@page
@model HalfChessServer.Pages.Histories.DeleteModel

@{
    ViewData["Title"] = "Delete";
    ViewData["nav"] = "Histories";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>Games</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.History.AtFrom)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.History.AtFrom)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.History.AtTo)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.History.AtTo)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.History.Result)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.History.Result)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.History.Player)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.History.Player.Name)
        </dd>
    </dl>
    
    <form method="post">
        <input type="hidden" asp-for="History.Id" />
        <input type="submit" value="Delete" class="btn btn-danger" /> |
        <a asp-page="./Index">Back to List</a>
    </form>
</div>
