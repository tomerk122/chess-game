@page
@model HalfChessServer.Pages.Players.DetailsModel

@{
    ViewData["nav"] = "Players";
    ViewData["Title"] = "Details";
    Layout = "~/Pages/Shared/_Layout.cshtml";
}

<h1>Details</h1>

<div>
    <h4>Player</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Player.PlayerNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Player.PlayerNumber)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Player.Name)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Player.Name)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Player.PhoneNumber)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Player.PhoneNumber)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Player.RegistedDate)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Player.RegistedDate)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Player.Quantity)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Player.Quantity)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Player.Country)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Player.Country.Name)
        </dd>
    </dl>
</div>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Player.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
